services:
  panel:
    image: ghcr.io/pelican/panel:v1.0.0-rc.2
    restart: always
    networks:
      - default
    ports:
      - "127.0.0.1:8102:80"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - pelican-data:/pelican-data
      - pelican-logs:/var/www/html/storage/logs
      - pelican-plugins:/var/www/html/plugins
      - ./Caddyfile:/etc/caddy/Caddyfile
      - ./php-hardening.ini:/usr/local/etc/php/conf.d/zzzz-hardening.ini:ro
    environment:
      XDG_DATA_HOME: /pelican-data
      APP_URL: "https://pelican.{{ net_domain }}"
      BEHIND_PROXY: "true"
      TRUSTED_PROXIES: "172.30.0.0/16"
      DB_CONNECTION: mariadb
      DB_HOST: "sql.{{ net_domain }}"
      DB_PORT: "3306"
      DB_DATABASE: dylanw_pelican
      DB_USERNAME: dylanw
      DB_PASSWORD: "{{ vault_mariadb_passwords['dylanw'] }}"

volumes:
  pelican-data:
  pelican-logs:
  pelican-plugins:

networks:
  default:
    ipam:
      config:
        - subnet: 172.30.0.0/16
